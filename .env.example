# Copy to .env and fill in. .env is git-ignored; docker compose and user-service read it automatically.

# Postgres superuser "admin" (Keycloak uses it for its database too)
POSTGRES_PASSWORD=change-me
# Keycloak admin console (user: admin)
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Per-service database users, created by docker/postgres/init.sh on first start (empty data volume)
USER_DB_PASSWORD=change-me
ORCHESTRATOR_DB_PASSWORD=change-me
WALLET_DB_PASSWORD=change-me
RISK_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me

# Shared secret between Keycloak (keycloak-user-sync) and user-service (X-Api-Key header)
USER_SYNC_API_KEY=change-me

ELASTICSEARCH_API_KEY=change-me
